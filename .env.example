# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/electrokart?retryWrites=true&w=majority

# Auth
JWT_SECRET=your_long_random_secret_here

# Server
PORT=5000
NODE_ENV=production

# Optional: only if frontend is on a different domain (e.g. Vercel)
FRONTEND_URL=https://your-app.vercel.app

# Payments (use test keys for staging)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYPAL_CLIENT_ID=

# Optional: first admin (run: node backend/scripts/initAdmin.js)
ADMIN_EMAIL=admin@admin.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
